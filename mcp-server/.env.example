DATABASE_URL=postgresql://user:password@host/database?sslmode=require
MCP_API_KEY=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-the-same-key-used-by-the-main-app
GOOGLE_CLIENT_ID=replace-with-the-same-client-id-used-by-the-main-app
GOOGLE_CLIENT_SECRET=replace-with-the-same-client-secret-used-by-the-main-app
# Comma-separated hostnames allowed by file_import_url. Subdomains are included.
MCP_IMPORT_HOSTS=lh3.googleusercontent.com,drive.google.com
PORT=3000
