# Postgres (Neon). Required on Vercel. If unset locally, the app uses a file-backed PGlite database in ./data
DATABASE_URL=

# bcrypt hash of the app password. Generate with: npm run hash-password
# Wrap the hash in single quotes OR escape `$` as `\$` so dotenv does not expand it.
APP_PASSWORD_HASH='replace-with-bcrypt-hash'

# 32+ byte random string for signing the session cookie
SESSION_SECRET=replace-with-a-long-random-string

# 32-byte hex key for encrypting the Google refresh token at rest
ENCRYPTION_KEY=replace-with-64-hex-chars

# Google OAuth (Drive file + Calendar events). Optional until you connect Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public app URL, e.g. https://your-app.vercel.app
APP_URL=http://127.0.0.1:43123

# Protects GET /api/cron/backup (Vercel Cron sends this as Authorization: Bearer ...)
CRON_SECRET=replace-me
