{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "feature/owner-construction-copilot": false
    }
  },
  "buildCommand": "next build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/backup",
      "schedule": "30 14 * * 0"
    },
    {
      "path": "/api/cron/daily-log",
      "schedule": "0 20 * * *"
    }
  ]
}
